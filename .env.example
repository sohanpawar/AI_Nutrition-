# LLM — openai | anthropic | stub
# stub = local deterministic responses (no API key required)
LLM_PROVIDER=stub
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MODEL_NAME=gpt-4o-mini
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=1
RATE_LIMIT_PER_MINUTE=30

# Storage (SQLite default for local; Postgres for Docker/prod)
# SQLite:
DATABASE_URL=sqlite:///./local.db
# Postgres (docker compose):
# DATABASE_URL=postgresql+psycopg://nutrition:nutrition@localhost:5432/nutrition
# Railway injects postgresql://… — the API normalizes it to +psycopg automatically.

# API — comma-separated browser origins (set to your Vercel URL in production)
CORS_ORIGINS=http://localhost:3000

# Web (apps/web) — public API base URL only; never put provider keys here
NEXT_PUBLIC_API_URL=http://localhost:8000
# Production example:
# NEXT_PUBLIC_API_URL=https://your-api.up.railway.app
